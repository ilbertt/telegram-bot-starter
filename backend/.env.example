# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
BOT_MODE=auto
# BASE_URL=https://your-app.example.com
DATA_FOLDER=./data
# Optional; generated into DATA_FOLDER and passed to Telegram when omitted.
# TELEGRAM_WEBHOOK_SECRET=
PORT=3000
# Tests and local HTTP smoke checks only; skips Telegram startup.
# TEST_ONLY_SKIP_TELEGRAM=true
